NODE_ENV=development
PORT=5000
# MONGO_URI=mongodb://127.0.0.1:27017/al_huda_trust
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Required only if the seed script needs to create the first Trust Admin:
SEED_ADMIN_EMAIL=admin@your-domain.example
SEED_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Optional; required only for Cloudinary upload functionality
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
